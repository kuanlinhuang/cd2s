[\"pdc_study_id\"] == STUDY\n            for v in s[\"versions\"] if v[\"is_latest_version\"] == \"yes\")\nq = '{ filesPerStudy(study_id: \"%s\" acceptDUA: true) { file_id file_name file_type data_category } }' % uuid\nfiles = requests.post(GQL, json={\"query\": q}).json()[\"data\"][\"filesPerStudy\"]\nprint(len(files), \"files\")\nPY","audience":"agent","evidence":[{"method":"derived","source_url":"https://pdc.cancer.gov/data-dictionary/publicapi-documentation/","source_label":"PDC data use guidelines","retrieved_at":"2026-09-20T15:22:08.484387Z","snippet":null,"locator":null,"confidence":"medium","reviewer":null,"reviewed_at":null,"note":"Generated by applying the repository's documented access policy to this dataset's identifiers. It is not a reviewer's account of this dataset, and a reviewed route replaces it where one exists."}]}],"analysis_examples":[],"agent_package":{"json_url":"/data/datasets/pdc-ptrc-tnbc-pdx.json","jsonld_url":"/data/jsonld/pdc-ptrc-tnbc-pdx.jsonld","croissant_url":"/data/croissant/pdc-ptrc-tnbc-pdx.json","instructions_url":"/data/agent/pdc-ptrc-tnbc-pdx.md","bundle_url":null,"mcp_resource_uri":null},"related_dataset_ids":[],"related_underexplored_ids":[],"review":{"status":"machine_only","reviewer":null,"reviewer_affiliation":null,"reviewed_at":null,"sections_reviewed":[],"open_questions":[],"notes":null},"verification":{"last_verified_at":null,"link_checks":[],"n_links_ok":0,"n_links_broken":0,"upstream_version_seen":null,"upstream_version_changed":false,"upstream_counts_seen":{},"upstream_drift":{},"notes":[]},"is_showcase":false,"completeness_score":10.7,"tags":["pdc","proteogenomics"],"search_text":null}