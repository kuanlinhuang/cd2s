  "@id": "https://cancer-data-showcase.example.org/datasets/gdc-cgci-htmcp-lc",
  "name": "HIV+ Tumor Molecular Characterization Project - Lung Cancer",
  "alternateName": [
    "cgci_htmcp_lc"
  ],
  "description": "People living with HIV have substantially elevated lung cancer incidence and worse outcomes, and are close to absent from the cohorts that define lung cancer genomics. This is the smallest cohort we have made a showcase page for, and we included it because size is not the only thing that determines whether a dataset is worth knowing about.\nAll 39 cases carry whole genome sequencing, 38 RNA sequencing and 37 microRNA. 26 patients are recorded as Black or African American. Pathologic stage is recorded for 62% and prior treatment for 92%, both unusually good for a cohort of this size.",
  "url": "https://cancer-data-showcase.example.org/datasets/gdc-cgci-htmcp-lc",
